    },
    {
      "id": "ru-krylov-cart",
      "source": "И. Крылов · Лебедь, Рак и Щука",
      "sourceUrl": "",
      "translation": "可那辆大车，如今还停在老地方。",
      "words": [
        { "text": "А", "annotation": "a", "translation": "可是", "suffix": "" },
        { "text": "воз", "annotation": "voz", "translation": "大车", "suffix": "" },
