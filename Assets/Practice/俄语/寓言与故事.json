      "source": "А. Пушкин · 长诗手稿题记",
      "sourceUrl": "",
      "translation": "童话是假话，可里面有暗示，给好汉子们上一课。",
      "words": [
        { "text": "Сказка", "annotation": "skazka", "translation": "童话", "suffix": "" },
        { "text": "—", "annotation": "—", "translation": "破折号，按 - 键", "suffix": "" },
        { "text": "ложь", "annotation": "lozh'", "translation": "假话", "suffix": "," },
        { "text": "да", "annotation": "da", "translation": "可是", "suffix": "" },
        { "text": "в", "annotation": "v", "translation": "在…里", "suffix": "" },
        { "text": "ней", "annotation": "ney", "translation": "它（介格）", "suffix": "" },
        { "text": "намёк", "annotation": "namyok", "translation": "暗示", "suffix": "," },
        { "text": "добрым", "annotation": "dobrym", "translation": "善良的好（与格复数）", "suffix": "" },
        { "text": "молодцам", "annotation": "molodtsam", "translation": "汉子们（与格）", "suffix": "" },
        { "text": "урок", "annotation": "urok", "translation": "一课、教训", "suffix": "." }
