    {
      "id": "ru-pushkin-oak",
      "source": "А. Пушкин · Руслан и Людмила",
      "sourceUrl": "",
      "translation": "那只有学问的猫，白天黑夜都绕着那条链子走来走去。",
      "words": [
        { "text": "И", "annotation": "i", "translation": "无论…还是…", "suffix": "" },
        { "text": "днём", "annotation": "dnyom", "translation": "在白天", "suffix": "" },
        { "text": "и", "annotation": "i", "translation": "又", "suffix": "" },
        { "text": "ночью", "annotation": "noch'yu", "translation": "在夜里", "suffix": "" },
        { "text": "кот", "annotation": "kot", "translation": "猫", "suffix": "" },
        { "text": "учёный", "annotation": "uchyonyy", "translation": "有学问的", "suffix": "" },
        { "text": "всё", "annotation": "vsyo", "translation": "总是", "suffix": "" },
        { "text": "ходит", "annotation": "khodit", "translation": "走", "suffix": "" },
        { "text": "по", "annotation": "po", "translation": "沿着", "suffix": "" },
        { "text": "цепи", "annotation": "tsepi", "translation": "链子（与格）", "suffix": "" },
        { "text": "кругом", "annotation": "krugom", "translation": "绕着圈", "suffix": "." }
      ]
    },
    {
