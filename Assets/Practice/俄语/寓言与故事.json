    },
    {
      "id": "ru-krylov-box",
      "source": "И. Крылов · Ларчик",
      "sourceUrl": "",
      "translation": "而那小匣子，本来就是轻轻一碰就开的。",
      "words": [
        { "text": "А", "annotation": "a", "translation": "可是", "suffix": "" },
        { "text": "ларчик", "annotation": "larchik", "translation": "小匣子", "suffix": "" },
