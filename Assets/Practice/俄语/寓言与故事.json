    },
    {
      "id": "ru-proverb-fish",
      "source": "俄语谚语",
      "sourceUrl": "",
      "translation": "不费力气，连小鱼也从池塘里捞不上来。",
      "words": [
        { "text": "Без", "annotation": "bez", "translation": "没有（属格连用）", "suffix": "" },
