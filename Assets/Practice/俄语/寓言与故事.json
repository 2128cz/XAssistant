        { "text": "Жили-были", "annotation": "zhili-byli", "translation": "曾住着（开场套语）", "suffix": "" },
        { "text": "старик", "annotation": "starik", "translation": "老头子", "suffix": "" },
        { "text": "со", "annotation": "so", "translation": "和、跟", "suffix": "" },
        { "text": "старухой", "annotation": "starukoy", "translation": "老太婆（工具格）", "suffix": "." }
      ]
    },
    {
      "id": "ru-tolstoy-land",
      "source": "Л. Толстой · Много ли человеку земли нужно?",
      "sourceUrl": "",
      "translation": "一个人究竟需要多少土地？",
      "words": [
        { "text": "Много", "annotation": "mnogo", "translation": "多少", "suffix": "" },
        { "text": "ли", "annotation": "li", "translation": "（疑问小品词）", "suffix": "" },
