<UserControl
  x:Class="XAssistant.Views.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
  xmlns:converters="clr-namespace:XAssistant.Converters">
  <UserControl.Resources>
    <converters:InvertableBooleanToVisibilityConverter
      x:Key="BoolToVis" />
    <CollectionViewSource
      x:Key="KeyRanking"
      Source="{Binding Keyboard.TodayKeyCounts}"
      IsLiveSortingRequested="True">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription
          PropertyName="Count"
          Direction="Descending" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <Style
      x:Key="Panel"
      TargetType="Border">
      <Setter
        Property="Background"
        Value="{DynamicResource CardBackground}" />
      <Setter
        Property="BorderBrush"
        Value="{DynamicResource CardBorderBrush}" />
      <Setter
        Property="BorderThickness"
        Value="1" />
      <Setter
        Property="CornerRadius"
        Value="12" />
      <Setter
        Property="Padding"
        Value="22" />
    </Style>
    <Style
      x:Key="Label"
      TargetType="TextBlock">
      <Setter
        Property="Foreground"
        Value="{DynamicResource TextSecondary}" />
      <Setter
        Property="FontSize"
        Value="13" />
    </Style>
    <Style
      x:Key="Number"
      TargetType="TextBlock">
      <Setter
        Property="FontFamily"
        Value="Consolas" />
      <Setter
        Property="FontSize"
        Value="34" />
      <Setter
        Property="Foreground"
        Value="{DynamicResource TextPrimary}" />
      <Setter
        Property="Margin"
        Value="0,14,0,10" />
    </Style>
    <Style
      x:Key="Title"
      TargetType="TextBlock">
      <Setter
        Property="FontSize"
        Value="17" />
      <Setter
        Property="FontWeight"
        Value="SemiBold" />
      <Setter
        Property="Foreground"
        Value="{DynamicResource TextPrimary}" />
      <Setter
        Property="Margin"
        Value="0,0,0,18" />
    </Style>
    <Style
      x:Key="Link"
      TargetType="Button"
      BasedOn="{StaticResource {x:Type Button}}">
      <Setter
        Property="Foreground"
        Value="{DynamicResource AccentBrush}" />
      <Setter
        Property="Background"
        Value="Transparent" />
      <Setter
        Property="BorderThickness"
        Value="0" />
      <Setter
        Property="Padding"
        Value="0,8" />
      <Setter
        Property="HorizontalAlignment"
        Value="Left" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
    <StackPanel
      Margin="12,12,12,24">
      <Grid
        Margin="0,4,0,28">
        <StackPanel>
          <TextBlock
            Text="INPUT / OVERVIEW"
            Foreground="{DynamicResource AccentBrush}"
            FontFamily="Consolas"
            FontSize="12"
            Margin="0,0,0,12" />
          <TextBlock
            Text="每一次输入，都有迹可循。"
            FontSize="29"
            FontWeight="SemiBold" />
          <TextBlock
            Text="实时了解你的键盘与鼠标习惯"
            Style="{StaticResource Label}"
            Margin="0,10,0,0" />
        </StackPanel>
        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Border
            Padding="12,8"
            Margin="0,0,12,0"
            CornerRadius="7"
            Background="{DynamicResource PanelBackground}">
            <TextBlock
              Text="{Binding Keyboard.KeyRecordingStatus}"
              Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <Button
            Content="Ⅱ  暂停键盘记录"
            Command="{Binding Keyboard.StopRecordingCommand}"
            Background="{DynamicResource AccentBrush}"
            Foreground="{DynamicResource AccentText}"
            Visibility="{Binding Keyboard.IsRecording, Converter={StaticResource BoolToVis}}" />
          <Button
            Content="▶  开始键盘记录"
            Command="{Binding Keyboard.StartRecordingCommand}"
            Background="{DynamicResource AccentBrush}"
            Foreground="{DynamicResource AccentText}"
            Visibility="{Binding Keyboard.IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
        </StackPanel>
      </Grid>
      <UniformGrid
        Columns="4"
        Margin="0,0,0,26">
        <Border
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="0,0,1,1"
          Padding="0,0,20,18">
          <StackPanel>
            <TextBlock
              Text="KBD / 键盘敲击 · 累计"
              Style="{StaticResource Label}" />
            <TextBlock
              Text="{Binding KeyTotalPresses, StringFormat=N0}"
              Style="{StaticResource Number}" />
            <TextBlock
              Text="{Binding KeyTodayPresses, StringFormat='今日 {0:N0} 次'}"
              Style="{StaticResource Label}" />
            <Button
              Style="{StaticResource Link}"
              Content="按键统计 ↗"
              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="KeyCounter" />
          </StackPanel>
        </Border>
        <Border
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="0,0,1,1"
          Padding="20,0,20,18">
          <StackPanel>
            <TextBlock
              Text="MSE / 鼠标点击 · 累计"
              Style="{StaticResource Label}" />
            <TextBlock
              Text="{Binding MouseTotalClicks, StringFormat=N0}"
              Style="{StaticResource Number}" />
            <TextBlock
              Text="{Binding MouseTodayClicks, StringFormat='今日 {0:N0} 次'}"
              Style="{StaticResource Label}" />
            <Button
              Style="{StaticResource Link}"
              Content="鼠标统计 ↗"
              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="ClickCounter" />
          </StackPanel>
        </Border>
        <Border
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="0,0,1,1"
          Padding="20,0,20,18">
          <StackPanel>
            <TextBlock
              Text="KPM / 实时输入速率"
              Style="{StaticResource Label}" />
            <TextBlock
              Text="{Binding Keyboard.KeysPerMinute, StringFormat=N0}"
              Style="{StaticResource Number}" />
            <TextBlock
              Text="键 / 分钟 · 最近 60 秒"
              Style="{StaticResource Label}" />
            <TextBlock
              Text="{Binding Keyboard.TodayAverageKeysPerMinute, StringFormat='今日平均 {0:0.0} 键/分钟'}"
              Style="{StaticResource Label}"
              Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="20,0,0,18">
          <StackPanel>
            <TextBlock
              Text="REC / 今日使用时长"
              Style="{StaticResource Label}" />
            <TextBlock
              Text="{Binding TodayUsageText}"
              Style="{StaticResource Number}"
              FontSize="30" />
            <TextBlock
              Text="电脑使用 · 会话记录"
              Style="{StaticResource Label}" />
            <Button
              Style="{StaticResource Link}"
              Content="查看会话 ↗"
              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="Usage" />
          </StackPanel>
        </Border>
      </UniformGrid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="*" />
          <ColumnDefinition
            Width="24" />
          <ColumnDefinition
            Width="290" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Border
            Style="{StaticResource Panel}"
            Background="{DynamicResource PanelBackground}"
            Margin="0,0,0,20">
            <StackPanel>
              <DockPanel>
                <TextBlock
                  DockPanel.Dock="Right"
                  Text="LIVE / INPUT"
                  FontFamily="Consolas"
                  Foreground="{DynamicResource AccentBrush}" />
                <TextBlock
                  Text="实时输入节奏"
                  Style="{StaticResource Title}" />
              </DockPanel>
              <WrapPanel
                Margin="0,0,0,16">
                <TextBlock
                  Text="{Binding Keyboard.LastKeyIntervalMs, StringFormat='上次间隔  {0} ms'}"
                  Style="{StaticResource Label}"
                  Margin="0,0,24,0" />
                <TextBlock
                  Text="{Binding Keyboard.AverageKeyIntervalMs, StringFormat='平均间隔  {0:0.0} ms'}"
                  Style="{StaticResource Label}" />
              </WrapPanel>
              <ItemsControl
                ItemsSource="{Binding Keyboard.RecentKeySequence}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Background="{DynamicResource KeyChipBackground}"
                      CornerRadius="6"
                      Padding="12,9"
                      Margin="0,0,6,6">
                      <TextBlock
                        Text="{Binding}"
                        FontFamily="Consolas"
                        Foreground="{DynamicResource KeyChipText}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                Text="等待键盘输入，最近的按键将在这里显示。"
                Margin="0,8">
                <TextBlock.Style>
                  <Style
                    TargetType="TextBlock"
                    BasedOn="{StaticResource Label}">
                    <Setter
                      Property="Visibility"
                      Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger
                        Binding="{Binding Keyboard.RecentKeySequence.Count}"
                        Value="0">
                        <Setter
                          Property="Visibility"
                          Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border
            Style="{StaticResource Panel}">
            <StackPanel>
              <DockPanel>
                <TextBlock
                  Text="TODAY / KEYS"
                  DockPanel.Dock="Right"
                  FontFamily="Consolas"
                  Foreground="{DynamicResource TextHint}" />
                <TextBlock
                  Text="今日按键分布"
                  Style="{StaticResource Title}" />
              </DockPanel>
              <TextBlock
                Text="按敲击次数排序 · 展示今天已记录的按键"
                Style="{StaticResource Label}"
                Margin="0,0,0,18" />
              <ItemsControl
                ItemsSource="{Binding Source={StaticResource KeyRanking}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Width="86"
                      Height="70"
                      Background="{DynamicResource PanelBackground}"
                      BorderBrush="{DynamicResource ControlBorder}"
                      BorderThickness="1"
                      CornerRadius="7"
                      Margin="0,0,8,8"
                      Padding="10">
                      <StackPanel>
                        <TextBlock
                          Text="{Binding Key}"
                          TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding Key}"
                          FontFamily="Consolas"
                          FontSize="15" />
                        <TextBlock
                          Text="{Binding Count, StringFormat=N0}"
                          Foreground="{DynamicResource AccentBrush}"
                          Margin="0,6,0,0"
                          FontFamily="Consolas" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                Text="今天还没有按键记录。"
                Margin="0,14">
                <TextBlock.Style>
                  <Style
                    TargetType="TextBlock"
                    BasedOn="{StaticResource Label}">
                    <Setter
                      Property="Visibility"
                      Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger
                        Binding="{Binding Keyboard.TodayKeyCounts.Count}"
                        Value="0">
                        <Setter
                          Property="Visibility"
                          Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border
          Grid.Column="2"
          Style="{StaticResource Panel}"
          VerticalAlignment="Top">
          <StackPanel>
            <TextBlock
              Text="今日软件使用"
              Style="{StaticResource Title}" />
            <TextBlock
              Text="APPLICATIONS / TODAY"
              FontFamily="Consolas"
              Foreground="{DynamicResource TextHint}"
              FontSize="11"
              Margin="0,0,0,18" />
            <ItemsControl
              ItemsSource="{Binding TopApps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="0,12">
                    <DockPanel>
                      <TextBlock
                        DockPanel.Dock="Right"
                        Text="{Binding FormattedUsage}"
                        Foreground="{DynamicResource AccentBrush}"
                        FontFamily="Consolas" />
                      <TextBlock
                        Text="{Binding DisplayName}"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,8,0" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              Text="暂无软件使用记录。"
              Margin="0,12">
              <TextBlock.Style>
                <Style
                  TargetType="TextBlock"
                  BasedOn="{StaticResource Label}">
                  <Setter
                    Property="Visibility"
                    Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding TopApps.Count}"
                      Value="0">
                      <Setter
                        Property="Visibility"
                        Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button
              Style="{StaticResource Link}"
              Content="查看全部软件 ↗"
              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="AppUsage"
              Margin="0,16,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>