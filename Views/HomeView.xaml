<UserControl
    x:Class="XAssistant.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  卡片基础样式  -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="12"
                        Opacity="0.1"
                        ShadowDepth="2" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  卡片标题（小号、不加粗）  -->
        <Style x:Key="ModuleTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!--  今日大数字  -->
        <Style x:Key="TodayBigStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource HighlightNumber}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  今日下方提示文字  -->
        <Style x:Key="TodayHintStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!--  总次数数字（比今日稍小）  -->
        <Style x:Key="TotalNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource HighlightNumber}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!--  总次数标签  -->
        <Style x:Key="TotalLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!--  详情链接按钮  -->
        <Style x:Key="DetailLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock
                            FontSize="14"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Content}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="None" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  录制状态文字  -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="20">

            <!--  ==================== 鼠标点击卡片 ====================  -->
            <Border
                Width="280"
                MinHeight="230"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  第一行：标题 + 录制状态  -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource ModuleTitleStyle}"
                            Text="鼠标点击" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{Binding MouseRecordingColor}"
                                Stroke="{DynamicResource TextSecondary}"
                                StrokeThickness="1" />
                            <TextBlock
                                Foreground="{Binding MouseRecordingColor}"
                                Style="{StaticResource StatusTextStyle}"
                                Text="{Binding MouseRecordingStatus}" />
                        </StackPanel>
                    </Grid>

                    <!--  第二行：占满高度，居中今日数据  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TodayBigStyle}" Text="{Binding MouseTodayClicks, StringFormat=N0}" />
                        <TextBlock Style="{StaticResource TodayHintStyle}" Text="今日点击" />
                    </StackPanel>

                    <!--  第三行：总次数靠左，详情按钮靠右，两端对齐  -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  总次数  -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource TotalNumberStyle}" Text="{Binding MouseTotalClicks, StringFormat=N0}" />
                            <TextBlock Style="{StaticResource TotalLabelStyle}" Text="总点击" />
                        </StackPanel>

                        <!--  详情  -->
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="ClickCounter"
                            Content="详情"
                            Style="{StaticResource DetailLinkStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <!--  ==================== 键盘记录卡片 ====================  -->
            <Border
                Width="280"
                MinHeight="230"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题行  -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource ModuleTitleStyle}"
                            Text="键盘记录" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="{Binding KeyRecordingColor}"
                                Stroke="{DynamicResource TextSecondary}"
                                StrokeThickness="1" />
                            <TextBlock
                                Foreground="{Binding KeyRecordingColor}"
                                Style="{StaticResource StatusTextStyle}"
                                Text="{Binding KeyRecordingStatus}" />
                        </StackPanel>
                    </Grid>

                    <!--  今日数据居中  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TodayBigStyle}" Text="{Binding KeyTodayPresses, StringFormat=N0}" />
                        <TextBlock Style="{StaticResource TodayHintStyle}" Text="今日按键" />
                    </StackPanel>

                    <!--  总次数 + 详情  -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Style="{StaticResource TotalNumberStyle}" Text="{Binding KeyTotalPresses, StringFormat=N0}" />
                            <TextBlock Style="{StaticResource TotalLabelStyle}" Text="总按键" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="KeyCounter"
                            Content="详情"
                            Style="{StaticResource DetailLinkStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <!--  ==================== 电脑使用卡片 ====================  -->
            <Border
                Width="280"
                MinHeight="230"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        Style="{StaticResource ModuleTitleStyle}"
                        Text="电脑使用" />

                    <!--  今日时长居中  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TodayBigStyle}" Text="{Binding TodayUsageText}" />
                        <TextBlock Style="{StaticResource TodayHintStyle}" Text="今日使用时长" />
                    </StackPanel>

                    <!--  底部只有详情按钮右对齐  -->
                    <Button
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="Usage"
                        Content="详情"
                        Style="{StaticResource DetailLinkStyle}" />
                </Grid>
            </Border>

            <!--  ==================== 软件使用卡片 ====================  -->
            <Border
                Width="280"
                MinHeight="230"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        Style="{StaticResource ModuleTitleStyle}"
                        Text="软件使用（今日）" />

                    <!--  软件列表，左对齐  -->
                    <ItemsControl
                        Grid.Row="1"
                        MaxHeight="100"
                        Margin="0,8,0,6"
                        VerticalAlignment="Center"
                        ItemsSource="{Binding TopApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,3"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextAlignment="Left">
                                    <Run Text="• " /><Run Text="{Binding DisplayName, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  底部详情  -->
                    <Button
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="AppUsage"
                        Content="详情"
                        Style="{StaticResource DetailLinkStyle}" />
                </Grid>
            </Border>

        </WrapPanel>
    </ScrollViewer>
</UserControl>
