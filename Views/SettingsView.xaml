<UserControl
  x:Class="XAssistant.Views.SettingsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:XAssistant.Converters"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <UserControl.Resources>
    <converters:InverseBoolConverter x:Key="InverseBool" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" VerticalAlignment="Top">

      <TextBlock
        FontSize="20"
        FontWeight="Bold"
        Text="设置" />

      <!--  ========== 键盘动画 ==========  -->
      <GroupBox
        Margin="0,16,0,0"
        Padding="14"
        Header="键盘动画">
        <StackPanel Orientation="Horizontal">
          <TextBlock
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{DynamicResource TextSecondary}"
            Text="在独立透明窗口中显示 2D 键盘（可开启透明背景实现屏幕透视效果）" />
          <Button
            Padding="14,6"
            Command="{Binding OpenKeyAnimationWindowCommand}"
            Content="打开键盘动画窗口" />
        </StackPanel>
      </GroupBox>

      <GroupBox
        Margin="0,16,0,0"
        Padding="14"
        Header="界面主题">
        <StackPanel>
          <TextBlock
            Margin="0,0,0,10"
            FontSize="12"
            Foreground="{DynamicResource TextSecondary}"
            Text="选择配色方案，切换即时生效并保存到配置文件，下次启动自动应用。" />
          <StackPanel Orientation="Horizontal">
            <RadioButton
              Margin="0,0,30,0"
              Command="{Binding ApplyLightCommand}"
              Content="☀ 浅色 · 苔绿"
              GroupName="Theme"
              IsChecked="{Binding IsDarkTheme, Converter={StaticResource InverseBool}, Mode=OneWay}" />
            <RadioButton
              Command="{Binding ApplyDarkCommand}"
              Content="🌙 深色 · KeyScope（默认）"
              GroupName="Theme"
              IsChecked="{Binding IsDarkTheme, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <!--  ========== 主题预览 ==========  -->
      <GroupBox
        Margin="0,16,0,0"
        Padding="14"
        Header="预览">
        <StackPanel Orientation="Horizontal">
          <Border
            Width="120"
            Height="70"
            Margin="0,0,12,0"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource HighlightNumber}"
                Text="12,345" />
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource TextSecondary}"
                Text="今日按键" />
            </StackPanel>
          </Border>
          <Border
            Width="120"
            Height="70"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock
                HorizontalAlignment="Center"
                FontWeight="Bold"
                Foreground="{DynamicResource AccentBrush}"
                Text="按钮示例" />
              <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{DynamicResource TextHint}"
                Text="次要文字" />
            </StackPanel>
          </Border>
        </StackPanel>
      </GroupBox>

    </StackPanel>
  </ScrollViewer>
</UserControl>