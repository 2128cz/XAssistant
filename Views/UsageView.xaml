<UserControl
    x:Class="XAssistant.Views.UsageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  今日使用时长  -->
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,20"
            Header="今日使用时长">
            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                FontSize="32"
                Text="{Binding TodayUsageText}" />
        </GroupBox>

        <!--  历史记录  -->
        <GroupBox Grid.Row="1" Header="历史使用时长">
            <DataGrid
                AutoGenerateColumns="False"
                ClipboardCopyMode="IncludeHeader"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding History}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Date}"
                        Header="日期" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding FormattedTime}"
                        Header="时长" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!--  会话事件记录  -->
        <GroupBox Grid.Row="2" Header="会话事件">
            <DataGrid
                AutoGenerateColumns="False"
                ClipboardCopyMode="IncludeHeader"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding SessionEvents}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Timestamp}"
                        Header="时间" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding EventType}"
                        Header="事件类型" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding TimeSincePrevious}"
                        Header="间隔" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding FormattedCumulativeUsage}"
                        Header="累计时长" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
