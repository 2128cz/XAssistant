<UserControl
    x:Class="XAssistant.Views.UsageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  今日使用时长  -->
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,10"
            Header="今日使用时长">
            <TextBlock
                Margin="10"
                HorizontalAlignment="Center"
                FontSize="32"
                Text="{Binding TodayUsageText}" />
        </GroupBox>

        <!--  说明  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,10"
            FontSize="12"
            Foreground="Gray"
            Text="说明：本页使用时长来自后台 UsageTracker 服务。服务按「会话整段记在会话开始的那一天」写入数据库；跨午夜的会话会被修正拆分到实际所属日期，因此个别日期的「修正时长」与数据库存在分钟级差异（原因见「修正原因」列），其余日期通常只有秒级计时误差。" />

        <!--  历史使用时长  -->
        <GroupBox Grid.Row="2" Header="历史使用时长">
            <DataGrid
                AutoGenerateColumns="False"
                ClipboardCopyMode="IncludeHeader"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding History}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Date}"
                        Header="日期" />
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding FormattedTime}"
                        Header="时长（数据库）" />
                    <!--  修正时长列 – 仅当存在差异时显示为红色强调  -->
                    <DataGridTextColumn
                        Width="200"
                        Binding="{Binding FormattedCorrectedTime}"
                        Header="修正时长">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                                        <Setter Property="Foreground" Value="Red" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="300"
                        Binding="{Binding CorrectionReason}"
                        Header="修正原因">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!--  会话事件记录  -->
        <GroupBox Grid.Row="3" Header="会话事件">
            <DataGrid
                AutoGenerateColumns="False"
                ClipboardCopyMode="IncludeHeader"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding SessionEvents}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Timestamp}"
                        Header="时间" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding EventType}"
                        Header="事件类型" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding TimeSincePrevious}"
                        Header="间隔" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding FormattedCumulativeUsage}"
                        Header="本次会话时长" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
