<UserControl
  x:Class="XAssistant.Views.KeyCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:XAssistant.Converters"
  xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
  xmlns:vm="clr-namespace:XAssistant.ViewModels">
  <UserControl.Resources>
    <converters:InvertableBooleanToVisibilityConverter x:Key="BoolToVis" />

    <!--  四个排序视图  -->
    <CollectionViewSource x:Key="SortedTotal" Source="{Binding KeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <CollectionViewSource x:Key="SortedToday" Source="{Binding TodayKeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <CollectionViewSource x:Key="SortedYesterday" Source="{Binding YesterdayKeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
    <CollectionViewSource x:Key="SortedDayBefore" Source="{Binding DayBeforeYesterdayKeyCounts, StringFormat=N0}">
      <CollectionViewSource.SortDescriptions>
        <scm:SortDescription Direction="Ascending" PropertyName="Length" />
        <scm:SortDescription Direction="Ascending" PropertyName="Key" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>

  <DockPanel>
    <!--  顶部按钮区  -->
    <StackPanel
      Margin="10"
      DockPanel.Dock="Top"
      Orientation="Horizontal">
      <Button
        Margin="0,0,10,0"
        Command="{Binding StartRecordingCommand}"
        Content="开始录制"
        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
      <Button
        Margin="0,0,10,0"
        Command="{Binding StopRecordingCommand}"
        Content="停止录制"
        Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
      <TextBlock VerticalAlignment="Center" Text="{Binding IsRecording, StringFormat='录制状态: {0}'}" />

      <Button
        Margin="10,0,0,0"
        Command="{Binding RefreshDataCommand}"
        Content="刷新数据" />
    </StackPanel>

    <!--  实时节奏区：速率 / 时间差 / 按键顺序  -->
    <GroupBox
      Margin="10,0,10,10"
      DockPanel.Dock="Top"
      Header="实时节奏">
      <StackPanel>
        <StackPanel
          Margin="8,6"
          Orientation="Horizontal">
          <TextBlock
            Margin="0,0,24,0"
            FontWeight="Bold"
            Text="{Binding KeysPerMinute, StringFormat='实时速率: {0} 键/分钟'}" />
          <TextBlock
            Margin="0,0,24,0"
            Text="{Binding LastKeyIntervalMs, StringFormat='上次间隔: {0} ms'}" />
          <TextBlock
            Margin="0,0,24,0"
            Text="{Binding AverageKeyIntervalMs, StringFormat='平均间隔: {0:0.0} ms'}" />
          <TextBlock Text="{Binding TodayAverageKeysPerMinute, StringFormat='今日平均: {0:0.0} 键/分钟'}" />
        </StackPanel>

        <ScrollViewer
          MaxHeight="72"
          HorizontalScrollBarVisibility="Disabled"
          VerticalScrollBarVisibility="Auto">
          <ItemsControl
            Margin="8,0,8,8"
            ItemsSource="{Binding RecentKeySequence}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border
                  Margin="0,0,4,4"
                  Padding="6,2"
                  Background="{DynamicResource KeyChipBackground}"
                  CornerRadius="3">
                  <TextBlock FontFamily="Consolas" Foreground="{DynamicResource KeyChipText}" Text="{Binding}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </GroupBox>

    <!--  Tab 切换区  -->
    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="总计">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedTotal}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="今天">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedToday}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="昨天">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedYesterday}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="前天">
        <DataGrid
          AutoGenerateColumns="False"
          ColumnWidth="*"
          ItemsSource="{Binding Source={StaticResource SortedDayBefore}}">
          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding Key}" Header="按键" />
            <DataGridTextColumn Binding="{Binding Count, StringFormat=N0}" Header="次数" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
