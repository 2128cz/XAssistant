<Window
  x:Class="XAssistant.Views.KeyAnimationWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:XAssistant.Views"
  Title="键盘动画"
  Width="1060"
  Height="640"
  WindowStyle="None"
  ResizeMode="NoResize"
  AllowsTransparency="True"
  Background="Transparent"
  Topmost="True"
  ShowInTaskbar="True">
  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  顶栏：拖拽移动 + 关闭  -->
    <Border
      Grid.Row="0"
      Background="Transparent"
      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="White"
          Text="键盘动画（拖拽移动 · 页面内可切透明背景）" />
        <Button
          x:Name="CloseButton"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Width="26"
          Height="26"
          Margin="0,0,8,0"
          Padding="0"
          Content="✕"
          FontSize="13"
          Foreground="White"
          BorderThickness="0"
          Background="#33000000"
          Cursor="Hand"
          Click="CloseButton_Click" />
      </Grid>
    </Border>

    <!--  内容：复用的键盘动画视图  -->
    <views:KeyAnimationView Grid.Row="1" />
  </Grid>
</Window>