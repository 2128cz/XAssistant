<UserControl
  x:Class="XAssistant.Views.ClickCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:XAssistant.Converters"
  xmlns:vm="clr-namespace:XAssistant.ViewModels">
  <UserControl.Resources>
    <converters:InverseBoolConverter x:Key="InverseBool" />

    <!--  小卡片样式（总计/历史）  -->
    <Style x:Key="SmallCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="80" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect
            BlurRadius="6"
            Opacity="0.15"
            ShadowDepth="2"
            Color="Gray" />
        </Setter.Value>
      </Setter>
    </Style>

    <!--  今日卡片样式（高亮）  -->
    <Style x:Key="TodayCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Width" Value="130" />
      <Setter Property="Height" Value="100" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect
            BlurRadius="8"
            Opacity="0.25"
            ShadowDepth="3"
            Color="Black" />
        </Setter.Value>
      </Setter>
    </Style>

    <!--  历史日期卡片样式  -->
    <Style x:Key="HistoryCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="Width" Value="120" />
      <Setter Property="Height" Value="80" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--  卡片内数字样式  -->
    <Style x:Key="CardBigNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!--  卡片内标题样式  -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" VerticalAlignment="Top">

      <!--  ========== 总计区域 ==========  -->
      <TextBlock
        Margin="0,0,0,8"
        FontSize="16"
        FontWeight="SemiBold"
        Text="总计" />
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <Border Style="{StaticResource SmallCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding LeftClickCount, StringFormat=N0}" />
            <TextBlock Style="{StaticResource CardTitle}" Text="总左键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SmallCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding MiddleClickCount, StringFormat=N0}" />
            <TextBlock Style="{StaticResource CardTitle}" Text="总中键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SmallCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding RightClickCount, StringFormat=N0}" />
            <TextBlock Style="{StaticResource CardTitle}" Text="总右键" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!--  ========== 今天（突出显示） ==========  -->
      <TextBlock
        Margin="0,25,0,10"
        FontSize="20"
        FontWeight="Bold"
        Text="今天" />
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
        <Border Style="{StaticResource TodayCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="32"
              FontWeight="Bold"
              Foreground="White"
              Text="{Binding LeftClickToday, StringFormat=N0}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="13"
              Foreground="White"
              Text="左键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TodayCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="32"
              FontWeight="Bold"
              Foreground="White"
              Text="{Binding MiddleClickToday, StringFormat=N0}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="13"
              Foreground="White"
              Text="中键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource TodayCardStyle}">
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="32"
              FontWeight="Bold"
              Foreground="White"
              Text="{Binding RightClickToday, StringFormat=N0}" />
            <TextBlock
              Margin="0,4,0,0"
              HorizontalAlignment="Center"
              FontSize="13"
              Foreground="White"
              Text="右键" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!--  ========== 日历与历史查看 ==========  -->
      <GroupBox
        Margin="0,25,0,0"
        Padding="10"
        Header="查看历史">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="260" />
          </Grid.ColumnDefinitions>

          <!--  日历控件  -->
          <Calendar
            Grid.Column="0"
            DisplayMode="Month"
            IsTodayHighlighted="True"
            SelectedDate="{Binding SelectedDate}" />

          <!--  选中日期的统计卡片  -->
          <StackPanel
            Grid.Column="1"
            Margin="15,0,0,0"
            VerticalAlignment="Top">
            <TextBlock
              Margin="0,0,0,12"
              FontSize="16"
              FontWeight="SemiBold"
              Text="{Binding SelectedDate, StringFormat='📅 {0:yyyy/MM/dd}'}" />
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
              <Border Style="{StaticResource HistoryCardStyle}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding SelectedDateLeftCount, StringFormat=N0}" />
                  <TextBlock Style="{StaticResource CardTitle}" Text="左键" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HistoryCardStyle}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding SelectedDateMiddleCount, StringFormat=N0}" />
                  <TextBlock Style="{StaticResource CardTitle}" Text="中键" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource HistoryCardStyle}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource CardBigNumber}" Text="{Binding SelectedDateRightCount, StringFormat=N0}" />
                  <TextBlock Style="{StaticResource CardTitle}" Text="右键" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!--  ========== 控制按钮 ==========  -->
      <StackPanel
        Margin="0,20,0,10"
        HorizontalAlignment="Center"
        Orientation="Horizontal">
        <Button
          Width="120"
          Height="35"
          Margin="5"
          BorderBrush="{DynamicResource AccentBrush}"
          Command="{Binding StartRecordingCommand}"
          Content="▶ 开始记录"
          FontWeight="SemiBold"
          Foreground="{DynamicResource AccentBrush}"
          IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}" />
        <Button
          Width="120"
          Height="35"
          Margin="5"
          Background="{DynamicResource AccentBrush}"
          Command="{Binding StopRecordingCommand}"
          Content="⏹ 停止记录"
          FontWeight="SemiBold"
          Foreground="{DynamicResource AccentText}"
          IsEnabled="{Binding IsRecording}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>