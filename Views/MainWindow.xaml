<Window
  x:Class="XAssistant.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:XAssistant.ViewModels"
  Title="XAssistant"
  Width="1280"
  Height="720">

  <DockPanel>
    <!--  左侧菜单  -->
    <StackPanel
      Width="200"
      Background="#F0F0F0"
      DockPanel.Dock="Left">
      <Button
        Command="{Binding NavigateCommand}"
        CommandParameter="ClickCounter"
        Content="鼠标点击记录" />
      <Button
        Command="{Binding NavigateCommand}"
        CommandParameter="KeyCounter"
        Content="键盘记录" />
      <Button
        Command="{Binding NavigateCommand}"
        CommandParameter="Usage"
        Content="使用统计" />

      <Separator Margin="0,20,0,5" />
      <CheckBox
        Margin="10,5"
        Content="开机自动启动"
        IsChecked="{Binding IsStartWithWindowsEnabled}" />
    </StackPanel>

    <!--  右侧内容区，根据 CurrentViewModel 自动切换视图  -->
    <ContentControl Content="{Binding CurrentViewModel}" />
  </DockPanel>
</Window>
