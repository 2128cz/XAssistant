<Window
  x:Class="XAssistant.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="XAssistant"
  Background="{DynamicResource WindowBackground}"
  Foreground="{DynamicResource TextPrimary}"
  Width="{Binding WindowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
  Height="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  第一行：原有的主界面  -->
    <DockPanel Grid.Row="0">
      <!--  左侧导航  -->
      <DockPanel
        Width="165"
        Background="{DynamicResource MenuBackground}"
        DockPanel.Dock="Left">
        <CheckBox
          Margin="12,5"
          DockPanel.Dock="Bottom"
          Content="开机自动启动"
          IsChecked="{Binding IsStartWithWindowsEnabled}" />
        <ListBox
          Margin="6,8"
          Background="Transparent"
          BorderThickness="0"
          ItemsSource="{Binding NavItems}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          SelectedItem="{Binding SelectedNavItem}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="2,2" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border
                      x:Name="bd"
                      Padding="{TemplateBinding Padding}"
                      Background="Transparent"
                      CornerRadius="6">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter
                          TargetName="bd"
                          Property="Background"
                          Value="{DynamicResource NavHoverBackground}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter
                          TargetName="bd"
                          Property="Background"
                          Value="{DynamicResource NavSelectedBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource NavSelectedForeground}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock
                  FontSize="15"
                  Text="{Binding Icon}" />
                <TextBlock
                  Margin="9,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="13"
                  Text="{Binding Label}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!--  右侧内容区  -->
      <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>

    <!--  第二行：全局日志面板  -->
    <Expander
      Grid.Row="1"
      Margin="5"
      Header="应用日志"
      IsExpanded="{Binding IsLogExpanded, Mode=TwoWay}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="200" />
          <!--  固定高度，也可设 * 但建议固定  -->
        </Grid.RowDefinitions>

        <!--  工具栏  -->
        <StackPanel
          Grid.Row="0"
          Margin="5"
          Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Text="筛选级别：" />
          <ComboBox
            Width="120"
            Margin="5,0"
            ItemsSource="{Binding LogLevelOptions}"
            SelectedItem="{Binding LogLevelFilter}" />
          <Button
            Margin="10,0,0,0"
            Command="{Binding ClearLogsCommand}"
            Content="清空日志" />
        </StackPanel>

        <!--  日志列表  -->
        <ListView
          Grid.Row="1"
          BorderBrush="{DynamicResource ControlBorder}"
          BorderThickness="1"
          ItemsSource="{Binding FilteredLogs}"
          VirtualizingPanel.ScrollUnit="Pixel">
          <ListView.View>
            <GridView>
              <GridViewColumn
                Width="200"
                DisplayMemberBinding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"
                Header="时间" />
              <GridViewColumn
                Width="80"
                DisplayMemberBinding="{Binding Level}"
                Header="级别" />
              <GridViewColumn
                Width="120"
                DisplayMemberBinding="{Binding SourceContext}"
                Header="来源" />
              <GridViewColumn
                Width="500"
                DisplayMemberBinding="{Binding Message}"
                Header="消息" />
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </Expander>
  </Grid>
</Window>
