<Window x:Class="XAssistant.Views.MainWindow" x:Name="Shell"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:XAssistant.Views"
 Title="XAssistant · KeyScope 工作台" MinWidth="1100" MinHeight="700"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}"
 Width="{Binding WindowWidth, Mode=TwoWay}" Height="{Binding WindowHeight, Mode=TwoWay}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/DashboardStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid>
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,0,32,24">
    <Border Padding="0,22" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◉  本机工作台" Foreground="{DynamicResource TextHint}" Margin="0,0,32,0"/><TextBlock Text="LC  /  我的工作台"/></StackPanel>
      <TextBlock Text="KEYSCOPE" DockPanel.Dock="Left" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource AccentBrush}" Margin="0,0,30,0"/>
      <StackPanel Orientation="Horizontal"><Button Content="实时概览" Tag="Overview" Click="NavigateSection" Style="{StaticResource TextButton}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,22,0"/><Button Content="习惯分析" Tag="Analysis" Click="NavigateSection" Style="{StaticResource TextButton}" Margin="0,0,22,0"/><Button Content="设备管理" Tag="Settings" Click="NavigateSection" Style="{StaticResource TextButton}"/></StackPanel>
     </DockPanel>
    </Border>
    <views:DashboardView x:Name="DashboardSurface" DataContext="{Binding Dashboard}"/>
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,18" Margin="0,24,0,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <TextBlock Text="{Binding ExportStatus}" Foreground="{DynamicResource TextHint}" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
       <ToggleButton x:Name="EventsButton" IsChecked="{Binding IsLogExpanded}" Padding="13,7" Margin="0,0,12,0" Background="{DynamicResource NavSelectedBackground}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource ControlBorder}"><TextBlock Text="{Binding FilteredLogCount, StringFormat='事件 · {0}  ⌃'}"/></ToggleButton>
       <Button Content="导出记录 ↗" Command="{Binding ExportRecordsCommand}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal"><Button Content="⚙" Tag="Settings" Click="NavigateSection" Style="{StaticResource TextButton}" Margin="0,0,12,0"/><CheckBox Content="开机自启动" IsChecked="{Binding IsStartWithWindowsEnabled}" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/><TextBlock Text="{Binding StartupDescription}" Foreground="{DynamicResource TextHint}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
     </DockPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Popup IsOpen="{Binding IsLogExpanded, Mode=TwoWay}" Placement="Top" PlacementTarget="{Binding ElementName=EventsButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" DataContext="{Binding DataContext, ElementName=Shell}">
   <Border Width="540" MaxHeight="590" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="24" CornerRadius="4">
    <StackPanel>
     <DockPanel><Button Content="×" DockPanel.Dock="Right" Command="{Binding CloseLogsCommand}" Style="{StaticResource TextButton}"/><TextBlock Text="事件日志" FontSize="19"/></DockPanel>
     <TextBlock Text="EVENT / 从底部「事件」打开 · 再次点击收起" Style="{StaticResource QuietText}" Margin="0,8,0,16"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><DatePicker SelectedDate="{Binding LogDate}" Width="156" Margin="0,0,10,0"/><ComboBox ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding LogLevelFilter}" Width="150"/><Button Content="清空日志" Command="{Binding ClearLogsCommand}" Margin="12,0,0,0"/></StackPanel>
     <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding FilteredLogs}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" Style="{StaticResource MonoText}"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Level}" Style="{StaticResource QuietText}" Margin="0,5,0,0"/><TextBlock Text="{Binding SourceContext}" Style="{StaticResource QuietText}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <DockPanel Margin="0,18,0,0"><Button DockPanel.Dock="Right" Content="导出当日日志 ↗" Command="{Binding ExportLogsCommand}" Style="{StaticResource TextButton}"/><TextBlock Text="{Binding FilteredLogCount, StringFormat='当天 {0} 条事件'}" VerticalAlignment="Center" Style="{StaticResource QuietText}"/></DockPanel>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</Window>
