<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XAssistant.ViewModels"
        x:Class="XAssistant.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="XAssistant" Width="1280" Height="720">
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="20" Spacing="10">
    <CheckBox IsChecked="{Binding IsStartWithWindowsEnabled}" Content="开机自启动"/>
        <TextBlock Text="左键点击: " FontSize="16"/>
        <TextBlock Text="{Binding LeftClickCount}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="中键点击: " FontSize="16"/>
        <TextBlock Text="{Binding MiddleClickCount}" FontSize="20" FontWeight="Bold" />
        <TextBlock Text="右键点击: " FontSize="16"/>
        <TextBlock Text="{Binding RightClickCount}" FontSize="20" FontWeight="Bold" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="开始记录" Command="{Binding StartRecordingCommand}"
                    IsEnabled="{Binding !IsRecording}"/>
            <Button Content="停止记录" Command="{Binding StopRecordingCommand}"
                    IsEnabled="{Binding IsRecording}"/>
        </StackPanel>
    </StackPanel>
</Window>