<Window
  x:Class="XAssistant.Views.QuickNoteWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="灵感速记"
  WindowStyle="None"
  ResizeMode="NoResize"
  Topmost="True"
  ShowInTaskbar="False"
  WindowStartupLocation="Manual"
  Background="#FFFFFF">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <Border BorderBrush="#CCCCCC" BorderThickness="1">
    <Grid Margin="14,10,14,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!--  标题栏：窗口名 + 关闭按钮  -->
      <Grid Grid.Row="0" Height="22" Margin="0,0,0,8">
        <TextBlock
          Text="灵感速记"
          FontSize="13"
          FontWeight="Bold"
          VerticalAlignment="Center"
          Foreground="#333333" />
        <Button
          x:Name="CloseButton"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Width="20"
          Height="20"
          Padding="0"
          Content="✕"
          FontSize="12"
          Foreground="#666666"
          BorderThickness="0"
          Background="Transparent"
          ToolTip="关闭（不保存）"
          Cursor="Hand"
          Click="CloseButton_Click" />
      </Grid>

      <!--  来源行：唤起瞬间的前台窗口标题，超长省略，悬停可看全文；无来源时隐藏  -->
      <TextBlock
        Grid.Row="1"
        Margin="0,0,0,8"
        Text="{Binding Source}"
        TextTrimming="CharacterEllipsis"
        Foreground="#888888"
        FontSize="12"
        ToolTip="{Binding Source}"
        Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

      <!--  正文输入：多行、自动聚焦、Enter 换行  -->
      <TextBox
        x:Name="ContentBox"
        Grid.Row="2"
        Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
        AcceptsReturn="True"
        AcceptsTab="True"
        TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"
        FontSize="14"
        Padding="4"
        BorderBrush="#D0D0D0" />

      <!--  保存失败提示：内容保留，可重试  -->
      <TextBlock
        Grid.Row="3"
        Margin="0,8,0,0"
        Text="{Binding ErrorMessage}"
        Foreground="#C62828"
        FontSize="12"
        TextWrapping="Wrap"
        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <!--  底部快捷键提示  -->
      <TextBlock
        Grid.Row="4"
        Margin="0,8,0,0"
        Text="Ctrl+Enter 保存　·　Esc / ✕ 取消"
        Foreground="#999999"
        FontSize="11"
        HorizontalAlignment="Right" />
    </Grid>
  </Border>
</Window>
