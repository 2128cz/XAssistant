<Window
  x:Class="XAssistant.Views.EffectsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="效果层"
  WindowStyle="None"
  ResizeMode="NoResize"
  AllowsTransparency="True"
  Background="Transparent"
  Topmost="True"
  ShowInTaskbar="False"
  ShowActivated="False"
  Focusable="False"
  IsHitTestVisible="False">
  <!--  整块铺满虚拟屏幕的效果层：粒子从顶部浮岛下方一颗颗落下来；触发时屏幕中间一句警告语，
        同时屏幕四边亮一圈——两者同一个透明度一起淡入淡出，算一个效果。
        窗口本身点击穿透（见代码里的 WS_EX_TRANSPARENT）也不抢焦点——本程序监听全局按键，
        彩蛋挡手或打断输入都是事故。  -->
  <Grid>
    <!--  边缘高亮：四边各一条从屏边向内渐隐的渐变带（画刷与带宽在代码里按 -border 参数生成）。
          分两层是为了两条动画不抢同一个属性：外层 Edge 走整段的淡入淡出，内层 EdgePulse 走
          持续段里的亮度呼吸循环——都写 Opacity 的话后挂的那条会把先挂的踩掉。  -->
    <Grid x:Name="Edge" Opacity="0" IsHitTestVisible="False">
      <Grid x:Name="EdgePulse">
        <Rectangle x:Name="EdgeTop" VerticalAlignment="Top"/>
        <Rectangle x:Name="EdgeBottom" VerticalAlignment="Bottom"/>
        <Rectangle x:Name="EdgeLeft" HorizontalAlignment="Left"/>
        <Rectangle x:Name="EdgeRight" HorizontalAlignment="Right"/>
      </Grid>
    </Grid>
    <!--  背景立绘：谁在说话，就把它那台 IDE 的图标当剪影垫在警告背后。外层 BackdropLayer 只管随整组
          淡入淡出，内层 Border 的 OpacityMask 用图标自身的 alpha、底色用这一组的档位色——
          所以任何一张带透明的 png 都能直接用，不需要另外准备白色图。  -->
    <Grid x:Name="BackdropLayer" Opacity="0" IsHitTestVisible="False">
      <Border x:Name="Backdrop" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
    <!--  警告语：同组的多条竖着排成一叠，整叠在屏幕中间。分三层是为了三条动画不抢同一个属性：
          外层 Rows 走整组的淡入淡出，内层 RowsPulse 走持续段里的闪烁，StackPanel 只管排版。
          每一行自己再套一层：内容层挂揭示用的 Clip（扫到哪亮到哪），扫描头是不被裁的兄弟节点。
          文字背后不垫背景框：垫了就像贴了块便利贴，跟这套 1 px 发丝线的界面不合。  -->
    <Grid x:Name="Rows" Opacity="0" IsHitTestVisible="False">
      <Grid x:Name="RowsPulse">
        <StackPanel x:Name="RowStack" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
    <Canvas x:Name="Stage" IsHitTestVisible="False" ClipToBounds="True"/>
    <!--  紧急档的四颗巨大警告三角：上下各两颗，分列屏宽 1/4 与 3/4 处（用户给的那张示意图就是这个布局）。
          放在 Tape 之外、窗口根上，才能拿到整屏尺寸；淡入淡出与 Tape 共用同一段动画。  -->
    <Canvas x:Name="Corners" IsHitTestVisible="False" ClipToBounds="False" Opacity="0"/>
  </Grid>
</Window>
