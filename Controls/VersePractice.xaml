<UserControl x:Class="XAssistant.Controls.VersePractice"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="Letter" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="22"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Style.Triggers><DataTrigger Binding="{Binding IsCorrect}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsWrong}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger><DataTrigger Binding="{Binding DataContext.HasError, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Border BorderBrush="#66DCC99D" BorderThickness="0,1" Background="{DynamicResource CardBackground}" Padding="18,16" IsEnabled="{Binding HasContent}">
  <StackPanel>
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{Binding FilterNote}"><ComboBox Width="92" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" Margin="0,0,8,0"/><ComboBox Width="128" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,8,0"/><Button Focusable="False" Content="清空" Command="{Binding ClearInputCommand}" Margin="0,0,8,0"/><Button Focusable="False" Content="换一句 ↗" Command="{Binding NextSentenceCommand}"/></StackPanel>
    <StackPanel><TextBlock Text="VERSE / 随机练习" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" FontSize="11"/><TextBlock Text="{Binding SourceText}" FontSize="11" Foreground="{DynamicResource TextHint}" Margin="0,5,8,0" TextWrapping="Wrap"/></StackPanel>
   </DockPanel>
   <ItemsControl ItemsSource="{Binding Words}" Margin="0,18,0,12">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Margin="0,0,14,12" Padding="0,2" BorderThickness="0,0,0,1" ToolTip="{Binding Translation}">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="Background" Value="#22FF6B6B"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <StackPanel><TextBlock Text="{Binding Annotation}" FontFamily="Segoe UI,Yu Gothic UI,MS Gothic" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextHint}" Margin="0,0,0,5"/>
       <ItemsControl ItemsSource="{Binding Characters}" HorizontalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Style="{StaticResource Letter}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <DockPanel Margin="0,0,0,10"><TextBlock Text="{Binding ProgressText}" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="19" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0"/><TextBlock Text="{Binding Translation}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/></DockPanel>
   <ProgressBar Value="{Binding VerseProgress}" Maximum="100" Height="3" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBorder}" BorderThickness="0" Margin="0,0,0,12"/>
   <DockPanel Margin="0,10,0,0"><CheckBox Focusable="False" Content="完成自动换句" IsChecked="{Binding AutoAdvance}" DockPanel.Dock="Right" Margin="16,0,0,0"/><TextBlock Text="{Binding VerseStatus}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  </StackPanel>
 </Border>
</UserControl>
