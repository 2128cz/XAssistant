<UserControl x:Class="XAssistant.Controls.WatchModulesPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!--  监视模块面板：整块内容由模块自己注册出来，宿主不认识任何具体模块。
       一行的控件形态两条规则：值是 bool 出勾选，其余出输入框；保密行走密码框（怎么遮由前端定）。
       元数据说不可输入就整行灰掉、说只允许数字就拦输入，模块那边还会再钳制一次。  -->
 <ItemsControl ItemsSource="{Binding Cards}">
  <ItemsControl.ItemTemplate>
   <DataTemplate>
    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource CardBackground}"
            Padding="18" Margin="0,0,0,14" SizeChanged="Card_SizeChanged">
     <StackPanel>
      <DockPanel LastChildFill="False">
       <!--  Enabled 是算出来的只读属性：IsChecked 默认 TwoWay，不回写就会在渲染时抛绑定异常 -->
       <CheckBox DockPanel.Dock="Right" Content="启用" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" Focusable="False"/>
       <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid Margin="0,3" IsEnabled="{Binding Editable}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Display}" ToolTip="{Binding Hint}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <CheckBox IsChecked="{Binding Check}" Click="Check_Click" Visibility="{Binding CheckVisibility}" Focusable="False"/>
           <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ValueVisibility}"
                    Tag="{Binding NumericOnly}" LostFocus="Text_LostFocus" PreviewTextInput="Numeric_PreviewTextInput"
                    FontFamily="Consolas" FontSize="12" Padding="6,3"/>
           <!--  密码框内容不能绑定：重建后从 VM 回填，否则改完一个值卡片一重画，刚粘的 cookie 就看起来没了  -->
           <PasswordBox Visibility="{Binding SecretVisibility}" Tag="{Binding}" LostFocus="Secret_LostFocus" Loaded="Secret_Loaded"
                        ToolTip="{Binding SecretHint}" FontFamily="Consolas" FontSize="12" Padding="6,3"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Unit}" Visibility="{Binding UnitVisibility}" FontSize="11"
                     Foreground="{DynamicResource TextHint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
   </DataTemplate>
  </ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
