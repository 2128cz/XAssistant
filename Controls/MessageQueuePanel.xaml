<UserControl x:Class="XAssistant.Controls.MessageQueuePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!--  工作台底部的消息管理区：头顶那张浮窗会被关掉、也会被条数上限淘汰，而「还有哪条告警在无限重播、
       怎么把它停掉」需要在主界面留一处能长期盯的地方。左列状态、中间正文、右侧剩余节奏，末列单条停止。
       历史折起来放下半区：回看不该天天占着工作台的高度。转换器就近声明，不赌全局资源在不在。  -->
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="TrueToVisible"/>
 </UserControl.Resources>
 <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource CardBackground}" Padding="22" Margin="0,20,0,0">
  <StackPanel>
   <DockPanel LastChildFill="False">
    <TextBlock Text="MESSAGE / 消息与播放队列" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="16"/>
    <Button Content="全部停止" Command="{Binding StopAllCommand}" DockPanel.Dock="Right" Padding="10,4" Focusable="False"/>
   </DockPanel>
   <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextHint}" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap"/>
   <ItemsControl ItemsSource="{Binding Active}">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Grid Margin="0,0,0,8">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="74"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="{Binding State}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="⚠" FontFamily="Segoe UI Symbol" FontSize="13" Foreground="{DynamicResource DangerBrush}" Margin="0,0,3,0"
                   Visibility="{Binding Urgent, Converter={StaticResource TrueToVisible}}"/>
        <TextBlock Text="{Binding Channel}" FontSize="11" Foreground="{DynamicResource TextHint}"/>
       </StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding Text}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock Grid.Column="3" Text="{Binding Detail}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextHint}"
                  VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBlock Grid.Column="4" Text="✕" FontSize="12" Cursor="Hand" ToolTip="停掉这一条" VerticalAlignment="Center"
                  Foreground="{DynamicResource TextHint}" MouseLeftButtonUp="StopRow_MouseLeftButtonUp"/>
      </Grid>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <Expander Header="最近历史" Margin="0,6,0,0" FontSize="12">
    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
     <ItemsControl ItemsSource="{Binding History}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <DockPanel Margin="0,3">
         <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11" Width="66" Foreground="{DynamicResource TextHint}"/>
         <TextBlock DockPanel.Dock="Right" Text="{Binding OutcomeText}" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource TextHint}"/>
         <!--  通道·tag·正文在 VM 里拼好：缺的段连同它前面的分隔符一起省，不留孤立的 “·”  -->
         <TextBlock Text="{Binding LineText}" FontSize="11" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
