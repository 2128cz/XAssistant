<UserControl x:Class="XAssistant.Controls.KeyboardHeatmap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False" Background="Transparent"
             FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="HeatmapNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#879794"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Border x:Name="FrameBorder" Background="#EB121A1D" BorderBrush="#4D6B8771" BorderThickness="1" CornerRadius="2">
        <Grid>
            <Border x:Name="TopAccent" Width="120" Height="2" Background="#A6C4FF75" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock x:Name="KeyboardWatermark" Text="144" FontFamily="Consolas" FontSize="103" Foreground="#1AC4FF75"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,185,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="SideCode" Text="KBD / 144" Foreground="#A6C4FF75" FontFamily="Consolas" FontSize="9"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,24,0,0">
                <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
            </TextBlock>
            <TextBlock x:Name="SideTitle" Text="键盘热力图" Foreground="#70B6D19A" FontSize="13"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,124">
                <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
            </TextBlock>
            <StackPanel x:Name="ContentStack" Margin="20,20,20,18">
                <TextBlock x:Name="HeaderPeriod" Text="{Binding PeriodLabel, ElementName=Root}" Style="{StaticResource HeatmapNote}"
                           HorizontalAlignment="Right" Margin="0,0,0,18"/>
                <Grid x:Name="HeaderLegend" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="按键颜色按本时段最少/最多次数归一化，越亮使用越频繁" Style="{StaticResource HeatmapNote}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LegendMinText" Text="-" Style="{StaticResource HeatmapNote}" FontFamily="Consolas" FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="低" Style="{StaticResource HeatmapNote}" FontSize="10" Margin="0,0,5,0"/>
                        <!-- 渐变条的 Stop 由代码按 HeatRamp 生成，与按键着色同源，保证深浅顺序一致 -->
                        <Border x:Name="LegendBar" Width="120" Height="8" CornerRadius="2"/>
                        <TextBlock Text="高" Style="{StaticResource HeatmapNote}" FontSize="10" Margin="5,0,6,0"/>
                        <TextBlock x:Name="LegendMaxText" Text="-" Style="{StaticResource HeatmapNote}" FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </Grid>
                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding KeyCaps, ElementName=Root}" Width="1120" Height="331">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                <Setter Property="Width" Value="{Binding Width}"/>
                                <Setter Property="Height" Value="43"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding HeatBrush}" BorderBrush="{Binding OutlineBrush}"
                                        BorderThickness="1" CornerRadius="2" Padding="5,4"
                                        ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" FontFamily="Consolas"
                                                   FontSize="10" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding CountText}" Foreground="{Binding CountBrush}" FontFamily="Consolas"
                                                   FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
                <Border BorderBrush="#4DADC488" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,10,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!--  位移窗：小鼠标图标朝指针移动方向偏移，并被钳在这个矩形内；偏移量由代码按 MouseOffsetX/Y 换算  -->
                        <Border x:Name="MoveField" Width="84" Height="62" BorderThickness="1" BorderBrush="#33BDD794" Background="#0ABDD794">
                            <Border.ToolTip>
                                <ToolTip Content="图标朝指针移动方向偏移，越快偏得越远，停下后回到中心；边界外不再位移"/>
                            </Border.ToolTip>
                            <Grid x:Name="MoveSurface" ClipToBounds="True" SizeChanged="OnMoveSurfaceSizeChanged">
                                <!--  内缩标记矩形：与代码里的 GlyphInset 同值，图标边缘正好停在这条线上  -->
                                <Border Margin="3" BorderThickness="1" BorderBrush="#14BDD794"/>
                                <Border Height="1" Background="#1ABDD794" VerticalAlignment="Center"/>
                                <Border Width="1" Background="#1ABDD794" HorizontalAlignment="Center"/>
                                <Viewbox x:Name="MouseGlyph" Width="20" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox.RenderTransform>
                                        <TranslateTransform x:Name="GlyphShift"/>
                                    </Viewbox.RenderTransform>
                                    <!--  内部几何按 22×26 作画，由 Viewbox 等比缩到上面声明的尺寸；改图标尺寸不必重排子元素  -->
                                    <Grid Width="22" Height="26">
                                        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.4" CornerRadius="11,11,10,10" Background="#260C1210"/>
                                        <!--  三块可点亮区域：点击时由代码把对应块的不透明度拉到顶再淡回  -->
                                        <Border x:Name="LeftClickZone" Width="9" Height="12" Margin="0.8,0.8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                CornerRadius="10,3,0,0" Background="{DynamicResource AccentBrush}" Opacity="0.12"/>
                                        <Border x:Name="RightClickZone" Width="9" Height="12" Margin="0,0.8,0.8,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                CornerRadius="3,10,0,0" Background="{DynamicResource AccentBrush}" Opacity="0.12"/>
                                        <Border x:Name="WheelZone" Width="2.8" Height="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.2,0,0"
                                                CornerRadius="1.4" Background="{DynamicResource AccentBrush}" Opacity="0.34"/>
                                        <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.4" Data="M 2.4,13.6 L 19.6,13.6"/>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="MSE" Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,24,0"/>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MouseDeltaText, ElementName=Root}" Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="Consolas" FontSize="11"/>
                            <TextBlock Text="{Binding MouseMovementText, ElementName=Root}" Style="{StaticResource HeatmapNote}"
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock x:Name="MouseCountsText" Foreground="#9AAEA5" FontSize="11" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding MouseDistanceText, ElementName=Root}" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas"
                                       FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <TextBlock.ToolTip>
                                    <ToolTip Content="按指针走过的屏幕路径乘以显示器点距折算；开了“提高指针精确度”时会低估手的真实行程"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Text="{Binding MouseWheelText, ElementName=Root}" Style="{StaticResource HeatmapNote}"
                                       FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                    <TextBlock x:Name="CoverageText" Grid.Column="1" Style="{StaticResource HeatmapNote}" FontSize="10"
                               ToolTipService.InitialShowDelay="150"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
