<UserControl x:Class="XAssistant.Controls.WordFrequencyPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <DockPanel>
   <!-- 小格标题统一 13 号：这块面板与旁边的练习成绩同格并列，字号再大就抢了板头的层次 -->
   <TextBlock Text="词频统计" Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
   <Button Command="{Binding RebuildCommand}" HorizontalAlignment="Right" FontSize="11" Padding="8,3">
    <TextBlock Text="{Binding RefreshLabel}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
    <Button.ToolTip><ToolTip MaxWidth="320"><TextBlock Text="{Binding RefreshTip}" TextWrapping="Wrap"/></ToolTip></Button.ToolTip>
   </Button>
  </DockPanel>
  <DockPanel Margin="0,10,0,12"><TextBlock Text="TEXT / FREQ" FontFamily="Consolas" Foreground="{DynamicResource TextHint}" VerticalAlignment="Center"/><ComboBox Width="90" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" HorizontalAlignment="Right"/></DockPanel>
  <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextHint}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
  <TextBlock Text="{Binding Pending}" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
  <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl ItemsSource="{Binding Words}"><ItemsControl.ItemTemplate><DataTemplate>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,6,0"><TextBlock Text="{Binding Word}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Word}" FontFamily="Consolas" FontSize="15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Style.Triggers><DataTrigger Binding="{Binding Mark}" Value="1"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding Mark}" Value="-1"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock FontSize="10" Foreground="{DynamicResource TextHint}"><Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" 次 · 修正 "/><Run Text="{Binding Corrections, Mode=OneWay}"/><Run Text=" 次"/></TextBlock>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="👍" FontFamily="Segoe UI Symbol" Padding="5,3" Margin="0,0,3,0" Command="{Binding DataContext.GoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="好 · 再点取消"/>
      <Button Content="👎" FontFamily="Segoe UI Symbol" Padding="5,3" Command="{Binding DataContext.BadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="不好 · 再点取消"/>
     </StackPanel>
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <Expander Header="最近输入" Margin="0,10,0,0"><ScrollViewer MaxHeight="200"><ItemsControl ItemsSource="{Binding Recent}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,5"><TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Width="100" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource TextHint}"/><TextBlock Text="{Binding Word}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Expander>
 </StackPanel>
</UserControl>
