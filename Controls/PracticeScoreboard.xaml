<UserControl x:Class="XAssistant.Controls.PracticeScoreboard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 外层留白与分隔线由调用方（工作台那块板的格子）给，控件自己不再带一圈 20 的空 -->
 <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CardBackground}" Padding="0,14,0,0">
  <StackPanel>
   <DockPanel><TextBlock Text="PRACTICE / 练习成绩" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="13"/></DockPanel>
   <UniformGrid Columns="2" Margin="0,12,0,10"><StackPanel><TextBlock Text="累计得分" Foreground="{DynamicResource TextHint}"/><TextBlock Text="{Binding TotalScore, StringFormat=N0}" FontSize="30" FontFamily="Consolas" Foreground="{DynamicResource DashboardNumber}"/></StackPanel><StackPanel><TextBlock Text="完成练习" Foreground="{DynamicResource TextHint}"/><TextBlock Text="{Binding CompletedRounds}" FontSize="30" FontFamily="Consolas" Foreground="{DynamicResource DashboardNumber}"/></StackPanel></UniformGrid>

   <Expander Header="最近练习" Margin="0,12,0,0"><StackPanel>
    <DataGrid ItemsSource="{Binding RecentResults}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Height="180"><DataGrid.Columns><DataGridTextColumn Header="完成时间" Binding="{Binding CompletedAt, StringFormat=MM-dd HH:mm}" Width="*"/><DataGridTextColumn Header="玩法" Binding="{Binding Mode}" Width="*"/><DataGridTextColumn Header="得分" Binding="{Binding Score}" Width="*"/><DataGridTextColumn Header="错误提交" Binding="{Binding Mistakes}" Width="*"/><DataGridTextColumn Header="用时 / 秒" Binding="{Binding Seconds}" Width="*"/></DataGrid.Columns></DataGrid>
   </StackPanel></Expander>
  </StackPanel>
 </Border>
</UserControl>
