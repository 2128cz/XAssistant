<Application
  x:Class="XAssistant.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:XAssistant.Views"
  xmlns:vm="clr-namespace:XAssistant.ViewModels">
  <Application.Resources>
    <ResourceDictionary>
      <!--  默认浅色主题（启动后按配置切换）  -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/ThemeLight.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <views:HomeView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:ClickCounterViewModel}">
        <views:ClickCounterView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:KeyCounterViewModel}">
        <views:KeyCounterView />
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:UsageViewModel}">
        <views:UsageView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:AppUsageViewModel}">
        <views:AppUsageView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>