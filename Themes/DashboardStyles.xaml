<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="DashboardPanel" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Padding" Value="20"/>
 </Style>
 <Style x:Key="QuietText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextHint}"/><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="MonoText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Style>
 <Style x:Key="MetricText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}"><Setter Property="FontSize" Value="44"/><Setter Property="Foreground" Value="{DynamicResource DashboardNumber}"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
 <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/></Style>
 <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,6"/></Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Padding" Value="18,12"/></Style>
 <Style x:Key="PeriodChoice" TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextHint}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="choice" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="choice" Property="Background" Value="{DynamicResource NavSelectedBackground}"/><Setter TargetName="choice" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="ToggleSwitch" TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><ContentPresenter VerticalAlignment="Center" Margin="0,0,10,0"/><Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="{DynamicResource ControlBorder}"><Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource TextPrimary}" HorizontalAlignment="Left" Margin="3,0"/></Border></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="track" Property="Background" Value="{DynamicResource NavSelectedBackground}"/><Setter TargetName="knob" Property="Fill" Value="{DynamicResource AccentBrush}"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="track" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="PeriodSelector" TargetType="ListBox">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  <!--  两行四列：时段选项从 4 个涨到 7 个，单行平铺会把“12 小时”挤到裁字。按现在的顺序刚好第一行是今天加小时级、第二行是天级  -->
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Rows="2"/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextHint}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="tab" Padding="3,7" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="tab" Property="Background" Value="{DynamicResource NavSelectedBackground}"/><Setter TargetName="tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
 </Style></ResourceDictionary>
